# Copy to .env and fill in. Never commit .env.
# Any OpenAI-compatible hosted API. Defaults: Google AI Studio (Gemma 4) + Cloudflare Workers AI (free tiers).

# Chat LLM (open-weight model, hosted)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it

# Embeddings (open-weight model, hosted)
EMBED_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<your-account-id>/ai/v1
EMBED_API_KEY=
EMBED_MODEL=@cf/baai/bge-m3

# Postgres + pgvector (matches docker-compose.yml, local dev only)
DATABASE_URL=postgresql+psycopg://catalist:catalist@localhost:5432/catalist
